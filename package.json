{
  "name": "budget-tracker",
  "version": "1.0.0",
  "description": "AI-powered personal finance management",
  "scripts": {
    "docker:dev": "docker-compose up -d",
    "docker:build": "docker-compose up --build -d",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v --remove-orphans",
    "docker:restart": "docker-compose restart",
    "docker:ps": "docker-compose ps",
    "dev:deps": "docker-compose up -d postgres redis",
    "dev:deps:down": "docker-compose stop postgres redis",
    "dev:api": "dotnet watch run --project api/BudgetTracker.API/BudgetTracker.API.csproj",
    "dev:frontend": "cd app && npm run dev",
    "dev:worker": "dotnet watch run --project worker/BudgetTracker.Worker/BudgetTracker.Worker.csproj",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:frontend\"",
    "build": "npm run build:api && npm run build:frontend",
    "build:api": "cd api/BudgetTracker.API && dotnet build",
    "build:frontend": "cd app && npm run build",
    "install:frontend": "cd app && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
